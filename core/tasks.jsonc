// core/tasks.jsonc - tasks available everywhere (space r r lists all tasks).
// Packs add their own. Zed variables: $ZED_FILE, $ZED_DIRNAME, $ZED_WORKTREE_ROOT, ...
[
  {
    "label": "zed-initiative: reinstall config",
    "command": "${python}",
    "args": ["${repo}/zedcfg.py", "install"],
    "cwd": "${repo}",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "zed-initiative: doctor",
    "command": "${python}",
    "args": ["${repo}/zedcfg.py", "doctor"],
    "cwd": "${repo}",
    "reveal": "always"
  }
]

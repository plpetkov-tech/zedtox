{
  "description": "Motion: Sneak (s + two chars jumps anywhere) and Helix jump-to-word labels. Disable with \"disable\": [\"motion\"] in local.jsonc",

  "requires": [],

  "keymap": [
    {
      // s <two chars> jumps forward, S backward; ; and , repeat like f/t.
      // This takes over vim's s (substitute char) and S (substitute line);
      // their equivalents are still there: `c l` for s, `c c` for S.
      //
      // space j labels every visible word start, Helix-style - type the label to
      // jump. Zed's docs bind this to `g w`, which would eat vim's rewrap.
      "context": "vim_mode == normal || vim_mode == visual",
      "bindings": {
        "s": "vim::PushSneak",
        "shift-s": "vim::PushSneakBackward",
        "space j": "vim::HelixJumpToWord"
      }
    }
  ]
}
